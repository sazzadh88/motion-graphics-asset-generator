# Copy to .env (gitignored) and fill in. Read by the API at startup; restart `npm run dev` after changes.

# --- AI generation ---
# Anthropic API key (https://console.anthropic.com). Leave empty to disable generation.
ANTHROPIC_API_KEY=
# Model used to write scenes.
MG_GENERATOR_MODEL=claude-sonnet-5-5
# Set to "mock" to try the generate flow without a key (returns adapted built-in templates).
MG_GENERATOR=

# --- API server (defaults shown) ---
# PORT=3001
# HOST=127.0.0.1
# STORAGE_DIR=./storage
# RENDER_CONCURRENCY=          # default: CPU cores / 4
# MAX_QUEUED=50
# OUTPUT_TTL_HOURS=24
# ASSET_TTL_DAYS=7
# DOWNLOAD_URL_TTL_SECONDS=3600
# SIGNING_SECRET=              # default: generated once into storage/.secret

# --- Render worker ---
# FFMPEG_PATH=                 # default: ffmpeg on PATH
# MG_BROWSER_MAX_JOBS=20       # recycle Chromium after this many jobs
# MG_NO_SANDBOX=               # set to 1 only inside containers that need it
