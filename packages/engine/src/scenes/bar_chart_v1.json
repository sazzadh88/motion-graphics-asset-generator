{
  "format": "mg-scene@1",
  "id": "bar_chart_v1",
  "name": "Bar Chart",
  "description": "Four-bar column chart whose bars grow to their values in a stagger, with counting value labels, a highlighted latest bar and a source line.",
  "category": "data",
  "defaultSettings": {
    "width": 1080,
    "height": 1080,
    "fps": 30,
    "durationFrames": 180,
    "transparent": false
  },
  "fonts": [
    "Montserrat Variable",
    "Inter Variable"
  ],
  "params": [
    {
      "key": "title",
      "label": "Title",
      "type": "text",
      "default": "Subscriptions now drive most of our revenue",
      "maxLength": 56,
      "group": "Text"
    },
    {
      "key": "subtitle",
      "label": "Subtitle",
      "type": "text",
      "default": "Share of total revenue by fiscal year",
      "maxLength": 64,
      "group": "Text"
    },
    {
      "key": "label1",
      "label": "Bar 1 label",
      "type": "text",
      "default": "2023",
      "maxLength": 16,
      "group": "Data"
    },
    {
      "key": "value1",
      "label": "Bar 1 value",
      "type": "number",
      "default": 38,
      "min": 0,
      "max": 1000000,
      "step": 1,
      "group": "Data"
    },
    {
      "key": "label2",
      "label": "Bar 2 label",
      "type": "text",
      "default": "2024",
      "maxLength": 16,
      "group": "Data"
    },
    {
      "key": "value2",
      "label": "Bar 2 value",
      "type": "number",
      "default": 51,
      "min": 0,
      "max": 1000000,
      "step": 1,
      "group": "Data"
    },
    {
      "key": "label3",
      "label": "Bar 3 label",
      "type": "text",
      "default": "2025",
      "maxLength": 16,
      "group": "Data"
    },
    {
      "key": "value3",
      "label": "Bar 3 value",
      "type": "number",
      "default": 67,
      "min": 0,
      "max": 1000000,
      "step": 1,
      "group": "Data"
    },
    {
      "key": "label4",
      "label": "Bar 4 label",
      "type": "text",
      "default": "2026",
      "maxLength": 16,
      "group": "Data"
    },
    {
      "key": "value4",
      "label": "Bar 4 value",
      "type": "number",
      "default": 84,
      "min": 0,
      "max": 1000000,
      "step": 1,
      "group": "Data"
    },
    {
      "key": "unit",
      "label": "Value suffix",
      "type": "text",
      "default": "%",
      "maxLength": 3,
      "group": "Data"
    },
    {
      "key": "source",
      "label": "Source line",
      "type": "text",
      "default": "Source: annual reports 2023-2026",
      "maxLength": 60,
      "group": "Text"
    },
    {
      "key": "bgColor",
      "label": "Background",
      "type": "color",
      "default": "#F2EFE7",
      "group": "Colors"
    },
    {
      "key": "inkColor",
      "label": "Text",
      "type": "color",
      "default": "#1C1F1E",
      "group": "Colors"
    },
    {
      "key": "barColor",
      "label": "Bars",
      "type": "color",
      "default": "#2F5D50",
      "group": "Colors"
    },
    {
      "key": "highlightColor",
      "label": "Highlight bar",
      "type": "color",
      "default": "#EE9A3A",
      "group": "Colors"
    },
    {
      "key": "highlightLast",
      "label": "Highlight last bar",
      "type": "boolean",
      "default": true,
      "group": "Style"
    },
    {
      "key": "showGrid",
      "label": "Grid lines",
      "type": "boolean",
      "default": true,
      "group": "Style"
    }
  ],
  "background": {
    "param": "bgColor"
  },
  "layers": [
    {
      "id": "panel",
      "type": "rect",
      "x": "50%w",
      "y": "50%h",
      "width": 96,
      "height": 96,
      "radius": 2.4,
      "fill": {
        "mix": [
          {
            "param": "bgColor"
          },
          "#FFFFFF"
        ],
        "t": 0.55
      },
      "stroke": {
        "color": {
          "param": "inkColor",
          "alpha": 0.06
        },
        "width": 0.2
      },
      "enter": {
        "preset": "scale-in",
        "duration": 0.8,
        "ease": "outExpo"
      },
      "exit": {
        "preset": "fade",
        "duration": 0.45
      }
    },
