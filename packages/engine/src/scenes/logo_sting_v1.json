{
  "format": "mg-scene@1",
  "id": "logo_sting_v1",
  "name": "Logo Sting",
  "description": "Four-second logo reveal: rings and shards converge, the logo pops with a shockwave and sparks, then the tagline types on. Shows a wordmark when no logo is set.",
  "category": "promo",
  "defaultSettings": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "durationFrames": 120,
    "transparent": false
  },
  "fonts": [
    "Montserrat Variable",
    "Inter Variable"
  ],
  "params": [
    {
      "key": "brand",
      "label": "Brand name (no logo)",
      "type": "text",
      "default": "Northwind",
      "maxLength": 18,
      "group": "Text"
    },
    {
      "key": "tagline",
      "label": "Tagline",
      "type": "text",
      "default": "Built for what comes next",
      "maxLength": 40,
      "group": "Text"
    },
    {
      "key": "logoUrl",
      "label": "Logo",
      "type": "image",
      "default": null,
      "group": "Media"
    },
    {
      "key": "bgColor",
      "label": "Background",
      "type": "color",
      "default": "#0D0D10",
      "group": "Colors"
    },
    {
      "key": "accentColor",
      "label": "Accent",
      "type": "color",
      "default": "#FF5B1F",
      "group": "Colors"
    },
    {
      "key": "accent2",
      "label": "Accent 2",
      "type": "color",
      "default": "#FFB547",
      "group": "Colors"
    },
    {
      "key": "lightColor",
      "label": "Text",
      "type": "color",
      "default": "#F3ECE2",
      "group": "Colors"
    },
    {
      "key": "showSparks",
      "label": "Sparks",
      "type": "boolean",
      "default": true,
      "group": "Style"
    }
  ],
  "background": {
    "param": "bgColor"
  },
  "layers": [
    {
      "id": "mark",
      "type": "group",
      "x": "50%w",
      "y": "50%h",
      "layers": [
        {
          "id": "wordmark",
          "type": "text",
          "visibleIf": {
            "param": "logoUrl",
            "not": true
          },
          "text": "{{brand|upper}}",
          "font": {
            "family": "Montserrat Variable",
            "weight": 900,
            "size": 11,
            "lineHeight": 1,
            "letterSpacing": 0.02
          },
          "color": {
            "param": "lightColor"
          },
          "align": "center",
          "maxWidth": 88,
          "maxLines": 1,
          "autoFit": {
            "minSize": 6
          },
          "y": -3,
          "start": 0.85,
          "enter": {
            "preset": "pop",
            "duration": 0.7
          },
          "exit": {
            "preset": "scale-in",
            "duration": 0.4,
            "delay": 0.12,
            "ease": "outCubic"
          }
        }
      ]
    },
    {
      "id": "glow",
      "type": "ellipse",
      "x": "50%w",
      "y": "50%h",
      "width": 120,
      "height": 120,
      "fill": {
        "radial": {
          "cx": "50%w",
          "cy": "50%h",
          "r": 50,
          "stops": [
            [
              0,
              {
                "param": "accentColor",
                "alpha": 0.2
              }
            ],
            [
              0.45,
              {
                "param": "accentColor",
                "alpha": 0.05
              }
            ],
            [
              1,
              {
                "param": "accentColor",
                "alpha": 0
              }
            ]
          ]
        }
      },
      "start": 0.6,
      "enter": {
        "preset": "fade",
        "duration": 0.8
      },
      "exit": {
        "preset": "fade",
        "duration": 0.5
      },
      "ambient": [
        {
          "prop": "scale",
          "amplitude": 0.04,
          "period": 2.5
        }
      ]
    },
    {
      "id": "fx",
      "type": "group",
      "x": "50%w",
      "y": "50%h",
      "layers": [
        {
          "id": "ringA",
