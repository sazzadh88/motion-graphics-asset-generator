{
  "format": "mg-scene@1",
  "id": "milestone_v1",
  "name": "Milestone Celebration",
  "description": "Follower milestone celebration: a big counter rolls up to your number over a rotating burst, with confetti, a thank-you line and your handle.",
  "category": "data",
  "defaultSettings": {
    "width": 1080,
    "height": 1350,
    "fps": 30,
    "durationFrames": 180,
    "transparent": false
  },
  "fonts": [
    "Anton",
    "Montserrat Variable",
    "Inter Variable"
  ],
  "params": [
    {
      "key": "value",
      "label": "Milestone",
      "type": "number",
      "default": 1000000,
      "min": 0,
      "max": 99999999,
      "step": 1,
      "group": "Number"
    },
    {
      "key": "suffix",
      "label": "Suffix",
      "type": "text",
      "default": "",
      "maxLength": 3,
      "group": "Number"
    },
    {
      "key": "label",
      "label": "Label",
      "type": "text",
      "default": "Followers",
      "maxLength": 18,
      "group": "Text"
    },
    {
      "key": "thanks",
      "label": "Thank-you line",
      "type": "text",
      "default": "Thank you for being part of this journey. Here is to the next million.",
      "maxLength": 90,
      "group": "Text"
    },
    {
      "key": "handle",
      "label": "Handle",
      "type": "text",
      "default": "@lumen.studio",
      "maxLength": 28,
      "group": "Text"
    },
    {
      "key": "bgColor",
      "label": "Background",
      "type": "color",
      "default": "#3B1B8F",
      "group": "Colors"
    },
    {
      "key": "bgColor2",
      "label": "Background 2",
      "type": "color",
      "default": "#B4166E",
      "group": "Colors"
    },
    {
      "key": "goldColor",
      "label": "Highlight",
      "type": "color",
      "default": "#FFC83D",
      "group": "Colors"
    },
    {
      "key": "confetti2",
      "label": "Confetti 2",
      "type": "color",
      "default": "#5FE3C0",
      "group": "Colors"
    },
    {
      "key": "confetti3",
      "label": "Confetti 3",
      "type": "color",
      "default": "#FF8CC6",
      "group": "Colors"
    },
    {
      "key": "showConfetti",
      "label": "Confetti",
      "type": "boolean",
      "default": true,
      "group": "Style"
    },
    {
      "key": "showBurst",
      "label": "Rotating burst",
      "type": "boolean",
      "default": true,
      "group": "Style"
    }
  ],
  "background": {
    "linear": {
      "angle": 150,
      "stops": [
        [
          0,
          {
            "param": "bgColor"
          }
        ],
        [
          1,
          {
            "param": "bgColor2"
          }
        ]
      ]
    }
  },
  "layers": [
    {
      "id": "glow",
      "type": "ellipse",
      "x": "50%w",
      "y": "50%h",
      "width": 110,
      "height": 110,
      "fill": {
        "radial": {
          "cx": "50%w",
          "cy": "50%h",
          "r": 50,
          "stops": [
            [
              0,
              {
                "param": "goldColor",
                "alpha": 0.22
              }
            ],
            [
              0.5,
              {
                "param": "goldColor",
                "alpha": 0.06
              }
            ],
            [
              1,
              {
                "param": "goldColor",
                "alpha": 0
              }
            ]
          ]
        }
      },
      "enter": {
        "preset": "scale-in",
        "duration": 1.2,
        "ease": "outExpo"
      },
      "exit": {
        "preset": "fade",
        "duration": 0.5
      },
      "ambient": [
        {
          "prop": "scale",
          "amplitude": 0.06,
          "period": 3
        }
      ]
    },
    {
      "id": "burst",
      "type": "polygon",
      "visibleIf": {
        "param": "showBurst"
      },
      "x": "50%w",
      "y": "50%h",
      "sides": 12,
      "radius": 46,
      "innerRadius": 30,
      "fill": {
        "param": "goldColor",
        "alpha": 0.07
      },
      "keyframes": {
        "rotation": [
          {
            "t": 0,
            "v": 0
          },
          {
            "t": 6,
            "v": 40
          }
        ]
      },
      "enter": {
        "preset": "scale-in",
        "duration": 1.1,
        "delay": 0.1,
        "ease": "outExpo"
      },
      "exit": {
        "preset": "fade",
        "duration": 0.5
      }
